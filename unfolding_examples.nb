Notebook[{
Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MyAdjacencyMatrix", "[", "G0_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", "=", "G0"}], "}"}], ",", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"VertexList", "[", "g", "]"}], "]"}]}], ";", 
     RowBox[{"A", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"x", "=", "1"}], ",", 
       RowBox[{"x", "\[LessEqual]", "n"}], ",", 
       RowBox[{"x", "++"}], ",", 
       RowBox[{
        RowBox[{"V", "=", 
         RowBox[{"VertexList", "[", 
          RowBox[{"NeighborhoodGraph", "[", 
           RowBox[{"g", ",", "x", ",", "1"}], "]"}], "]"}]}], ";", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"y", "=", "1"}], ",", 
          RowBox[{"y", "\[LessEqual]", 
           RowBox[{"Length", "[", "V", "]"}]}], ",", 
          RowBox[{"y", "++"}], ",", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", 
             RowBox[{"x", ",", 
              RowBox[{"V", "[", 
               RowBox[{"[", "y", "]"}], "]"}]}], "]"}], "]"}], "=", "1"}]}], 
         "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"A", "-", 
      RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"1e674c98-4b10-409a-b5ad-874a31918968"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Smash", "[", 
   RowBox[{"G0_", ",", "S0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"G", "=", "G0"}], ",", 
      RowBox[{"S", "=", "S0"}], ",", "V", ",", "A", ",", "Sbar"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Get", " ", "the", " ", "adjacency", " ", "matrix", " ", "of", " ", 
      "the", " ", "graph"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"A", "=", 
      RowBox[{"AdjacencyMatrix", "[", "G", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"V", "=", 
      RowBox[{"VertexList", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Map", " ", "vertex", " ", "labels", " ", "to", " ", "matrix", " ", 
       "indices"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"S", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"V", ",", "#"}], "]"}], "&"}], "/@", "S0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Sbar", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "V", "]"}], "]"}], ",", "S"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Compute", " ", "the", " ", "Schur", " ", "complement", " ", 
       "formula"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"S", ",", "S"}], "]"}], "]"}], "-", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"S", ",", "Sbar"}], "]"}], "]"}], ".", 
       RowBox[{"Inverse", "[", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", 
           RowBox[{"Sbar", ",", "Sbar"}], "]"}], "]"}], "-", 
         RowBox[{"\[Lambda]", " ", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "Sbar", "]"}], "]"}]}]}], "]"}], ".", 
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"Sbar", ",", "S"}], "]"}], "]"}]}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.96721555132753*^9, 3.967215553992529*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"00bcbdac-b052-4f84-86c7-f89e1a4d2c5d"],

