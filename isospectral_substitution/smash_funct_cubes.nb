Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "check", " ", "if", " ", "matrix", " ", 
    "exponential", " ", "is", " ", "identity"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"CheckIdentityCount", "[", "mat_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "expMat", "}"}], ",", 
      RowBox[{
       RowBox[{"expMat", "=", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"MatrixExp", "[", 
           RowBox[{"mat", " ", "I", " ", "t"}], "]"}], "/.", " ", 
          RowBox[{"t", "->", 
           RowBox[{"2", " ", "Pi"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"expMat", "=!=", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{
            RowBox[{"Dimensions", "[", "expMat", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"countNotIdentity", "++"}], ";", 
          RowBox[{"MatrixForm", "[", "expMat", "]"}]}]}], "]"}]}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.9509849255002947`*^9, 3.950984925500622*^9}, 
   3.950985333598853*^9},ExpressionUUID->"8f38d6eb-e829-4538-b8fd-\
22a2b02f7b2b"]
