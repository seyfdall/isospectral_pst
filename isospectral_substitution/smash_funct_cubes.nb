Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Smash", "[", 
    RowBox[{"G0_", ",", "S0_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"G", "=", "G0"}], ",", 
       RowBox[{"S", "=", "S0"}], ",", "V", ",", "A", ",", "Sbar"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Get", " ", "the", " ", "adjacency", " ", "matrix", " ", "of", " ", 
       "the", " ", "graph"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", "=", 
       RowBox[{"AdjacencyMatrix", "[", "G", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"V", "=", 
       RowBox[{"VertexList", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Map", " ", "vertex", " ", "labels", " ", "to", " ", "matrix", " ", 
        "indices"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"S", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"V", ",", "#"}], "]"}], "&"}], "/@", "S0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Sbar", "=", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "V", "]"}], "]"}], ",", "S"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Compute", " ", "the", " ", "Schur", " ", "complement", " ", 
        "formula"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"S", ",", "S"}], "]"}], "]"}], "-", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"[", 
          RowBox[{"S", ",", "Sbar"}], "]"}], "]"}], ".", 
        RowBox[{"Inverse", "[", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"[", 
            RowBox[{"Sbar", ",", "Sbar"}], "]"}], "]"}], "-", 
          RowBox[{"L", " ", 
           RowBox[{"IdentityMatrix", "[", 
            RowBox[{"Length", "[", "Sbar", "]"}], "]"}]}]}], "]"}], ".", 
        RowBox[{"A", "[", 
         RowBox[{"[", 
          RowBox[{"Sbar", ",", "S"}], "]"}], "]"}]}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SmashMatrix", ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "S", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Determine", " ", "the", " ", "complement", " ", "of", " ", "S", " ", 
       "in", " ", "the", " ", "range", " ", "of", " ", "matrix", " ", 
       "indices"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Sbar", "=", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "A", "]"}], "]"}], ",", "S"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
