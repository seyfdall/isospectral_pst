Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "graph"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"HypercubeGraph", "[", 
      RowBox[{"5", ",", 
       RowBox[{"VertexLabels", "->", "\"\<Name\>\""}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"MatrixForm", "[", 
     RowBox[{"AdjacencyMatrix", "[", "G", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Number", " ", "of", " ", "vertices", " ", "to", " ", "smash"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "check", " ", "if", " ", "matrix", " ", 
     "exponential", " ", "is", " ", "identity"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"CheckIdentity", "[", "mat_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "expMat", "}"}], ",", 
       RowBox[{
        RowBox[{"expMat", "=", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{"MatrixExp", "[", 
            RowBox[{"mat", " ", "I", " ", "t"}], "]"}], "/.", " ", 
           RowBox[{"t", "->", 
            RowBox[{"2", " ", "Pi"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"expMat", "=!=", 
           RowBox[{"IdentityMatrix", "[", 
            RowBox[{
             RowBox[{"Dimensions", "[", "expMat", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<Quantum walk matrix for combination is NOT identity:\\n\>\"", 
            ",", 
            RowBox[{"MatrixForm", "[", "expMat", "]"}]}], "]"}]}], "]"}], 
        ";"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Loop", " ", "over", " ", "all", " ", "combinations", " ", "of", " ", "n",
      " ", "vertices"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"combinations", "=", 
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "G", "]"}], ",", 
       RowBox[{"{", "n", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GSmash", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Smash", "[", 
         RowBox[{"G", ",", "combo"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Substitute", " ", "L"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"mat", "=", 
       RowBox[{"GSmash", "/.", " ", 
        RowBox[{"L", "->", "1"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Check", " ", "if", " ", "exponential", " ", "is", " ", "identity"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"CheckIdentity", "[", "mat", "]"}], ";"}], ",", 
     RowBox[{"{", 
      RowBox[{"combo", ",", "combinations"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
