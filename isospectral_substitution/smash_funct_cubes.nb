Cell[BoxData[
 RowBox[{
  RowBox[{"MyAdjacencyMatrix", "[", "G0_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", "=", "G0"}], "}"}], ",", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"VertexList", "[", "g", "]"}], "]"}]}], ";", 
     RowBox[{"A", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"x", "=", "1"}], ",", 
       RowBox[{"x", "\[LessEqual]", "n"}], ",", 
       RowBox[{"x", "++"}], ",", 
       RowBox[{
        RowBox[{"V", "=", 
         RowBox[{"VertexList", "[", 
          RowBox[{"NeighborhoodGraph", "[", 
           RowBox[{"g", ",", "x", ",", "1"}], "]"}], "]"}]}], ";", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"y", "=", "1"}], ",", 
          RowBox[{"y", "\[LessEqual]", 
           RowBox[{"Length", "[", "V", "]"}]}], ",", 
          RowBox[{"y", "++"}], ",", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", 
             RowBox[{"x", ",", 
              RowBox[{"V", "[", 
               RowBox[{"[", "y", "]"}], "]"}]}], "]"}], "]"}], "=", "1"}]}], 
         "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"A", "-", 
      RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.7899322575388355`*^9, 3.7899322876144795`*^9}, {
   3.7899325914500775`*^9, 3.78993259313508*^9}, {3.7899326445405464`*^9, 
