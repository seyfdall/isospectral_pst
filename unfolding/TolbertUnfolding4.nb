     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Helper", " ", "function", " ", "to", " ", "remove", " ", "the", " ", 
     "zero", " ", 
     RowBox[{"row", "/", "column"}], " ", "added", " ", "in", " ", 
