         RowBox[{"m", "=", 
          RowBox[{"Normal", "[", 
           RowBox[{"m", ",", 
            RowBox[{"SparseArray", "|", "StructuredArray"}]}], "]"}]}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MatrixQ", "[", 
           RowBox[{"m", ",", "NumericQ"}], "]"}], "&&", 
          RowBox[{
           RowBox[{"Internal`EffectivePrecision", "[", "m", "]"}], "<", 
           "\[Infinity]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"svd", "=", 
           RowBox[{"SingularValueDecomposition", "[", 
            RowBox[{"m", ",", 
             RowBox[{"FilterRules", "[", 
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"{", "opts", "}"}], ",", 
                 RowBox[{"Options", "[", "FullRankDecomposition", "]"}]}], 
                "]"}], ",", 
               RowBox[{"Options", "[", "SingularValueDecomposition", "]"}]}], 
              "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"MatchQ", "[", 
              RowBox[{"svd", ",", 
               RowBox[{"{", 
                RowBox[{"__", "?", "MatrixQ"}], "}"}]}], "]"}]}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"$Failed", ",", "Module"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"um", ",", "sig", ",", "vm"}], "}"}], "=", "svd"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"rank", "=", 
           RowBox[{"LengthWhile", "[", 
            RowBox[{
             RowBox[{"sig", "=", 
              RowBox[{"Diagonal", "[", "sig", "]"}]}], ",", 
             RowBox[{
              RowBox[{"#", "!=", "0"}], "&"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"um", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"1", ";;", "rank"}]}], "]"}], "]"}], ",", 
            RowBox[{"Times", "[", 
             RowBox[{
              RowBox[{"Take", "[", 
               RowBox[{"sig", ",", "rank"}], "]"}], ",", 
              RowBox[{"Take", "[", 
               RowBox[{
                RowBox[{"ConjugateTranspose", "[", "vm", "]"}], ",", "rank"}],
                "]"}]}], "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"rref", "=", 
           RowBox[{"RowReduce", "[", 
