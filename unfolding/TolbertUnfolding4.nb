Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Full", " ", "Rank", " ", "Decomposition", " ", "Definition"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "FullRankDecomposition", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Method", "\[Rule]", "Automatic"}], ",", 
       RowBox[{"Modulus", "\[Rule]", "0"}], ",", 
       RowBox[{"Tolerance", "\[Rule]", "Automatic"}], ",", 
       RowBox[{"ZeroTest", "\[Rule]", "Automatic"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FullRankDecomposition", "[", 
     RowBox[{
      RowBox[{"m_", "?", "MatrixQ"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"res", "=", 
        RowBox[{"iFullRankDecomposition", "[", 
         RowBox[{"m", ",", "opts"}], "]"}]}], "}"}], ",", 
      RowBox[{"res", "/;", 
       RowBox[{"MatchQ", "[", 
        RowBox[{"res", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"_", "?", "MatrixQ"}], ",", 
           RowBox[{"_", "?", "MatrixQ"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"iFullRankDecomposition", "[", 
     RowBox[{"ma_", ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "FullRankDecomposition", "]"}]}]}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"m", "=", "ma"}], ",", "gf", ",", "pos", ",", "rank", ",", 
