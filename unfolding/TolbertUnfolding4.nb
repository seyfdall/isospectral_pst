                RowBox[{"pos", ",", "rank"}], "]"}]}], "]"}], "]"}], ",", 
            RowBox[{"Take", "[", 
             RowBox[{"gf", ",", "rank"}], "]"}]}], "}"}]}]}], "]"}]}]}], 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
