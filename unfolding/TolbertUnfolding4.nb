        ",", 
       RowBox[{"found", "=", "False"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rows", ",", "cols"}], "}"}], "=", 
       RowBox[{"Dimensions", "[", "M", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Helper", " ", "function", " ", "to", " ", "test", " ", "top"}], "-", 
        
        RowBox[{
        "left", " ", "r", "\[Times]", "r", " ", "block", " ", "for", " ", 
         "all", " ", "zeros"}]}], "*)"}], 
      RowBox[{
       RowBox[{"isZeroBlockQ", "[", "r_", "]"}], ":=", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Flatten", "[", 
