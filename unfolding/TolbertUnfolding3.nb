                "]"}], ",", 
               RowBox[{"Options", "[", "SingularValueDecomposition", "]"}]}], 
              "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
