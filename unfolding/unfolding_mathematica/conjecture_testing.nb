           RowBox[{
            RowBox[{"Length", "[", "distancePartition", "]"}], "-", "1"}]}], 
          "}"}]}], "]"}], ",", "1"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
