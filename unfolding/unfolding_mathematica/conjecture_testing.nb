   ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"Smash", "[", 
   RowBox[{"H4", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"VertexCount", "[", "H4", "]"}]}], "}"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"Smash", "[", 
   RowBox[{"H4mod2", ",", 
