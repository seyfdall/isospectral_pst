  3.986311395648494*^9}},ExpressionUUID->"4b97d55f-a35d-406d-b4a9-\
c2fb77d5b091"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"G1", " ", "=", " ", 
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "<->", "2"}], ",", 
      RowBox[{"1", "<->", "3"}], ",", 
      RowBox[{"2", "<->", "3"}], ",", 
      RowBox[{"3", "<->", "4"}], ",", 
      RowBox[{"4", "<->", "5"}]}], "}"}], ",", " ", 
    RowBox[{"VertexLabels", "->", "Automatic"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"A1", " ", "=", " ", 
  RowBox[{"Normal", "[", 
   RowBox[{"AdjacencyMatrix", "[", "G1", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Eigenvalues", "[", "A1", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Eigenvectors", "[", "A1", "]"}], "\[IndentingNewLine]", 
 RowBox[{"G1S", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Smash", "[", 
    RowBox[{"G1", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "5"}], "}"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Det", "[", 
  RowBox[{"G1S", " ", "-", " ", 
   RowBox[{"\[Lambda]", " ", 
    RowBox[{"IdentityMatrix", "[", 
     RowBox[{"Length", "[", "G1S", "]"}], "]"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"CharacteristicPolynomial", "[", 
  RowBox[{"G1S", ",", " ", "\[Lambda]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"CharacteristicPolynomial", "[", 
     RowBox[{"G1S", ",", " ", "\[Lambda]"}], "]"}], "==", "0"}], ",", 
   "\[Lambda]"}], "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.986311439514235*^9, 3.9863115204028187`*^9}, {
  3.986311562741666*^9, 3.9863116096526213`*^9}, {3.9863118497234173`*^9, 
  3.986312010541253*^9}, {3.986312263578164*^9, 3.986312292048452*^9}, {
  3.9863123415305023`*^9, 3.986312375544883*^9}, {3.986312819517992*^9, 
