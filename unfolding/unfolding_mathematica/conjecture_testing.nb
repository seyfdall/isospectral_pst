        RowBox[{
         RowBox[{"0", " ", "x_v"}], "=", "0"}]}], "\[IndentingNewLine]", 
       "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"constraintMatrix", "=", 
