  3.986314065847474*^9}, {3.986314154213401*^9, 3.986314181254169*^9}, {
  3.986315001691674*^9, 3.986315002032939*^9}},
 CellLabel->
  "In[298]:=",ExpressionUUID->"83619b26-1e8e-4bfc-934c-d14c14fb67b7"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4, 5}, {
      Null, {{1, 2}, {1, 3}, {2, 3}, {3, 4}, {4, 5}}}, {
