Cell[CellGroupData[{

Cell["Eigenvalue Preservation in Isospectral Reduction", "Chapter",
 CellChangeTimes->{{3.9840733725458612`*^9, 3.98407337469825*^9}, {
  3.984073495112236*^9, 3.984073503855611*^9}, {3.984079768523798*^9, 
