      RowBox[{"A", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"x", "=", "1"}], ",", 
        RowBox[{"x", "\[LessEqual]", "n"}], ",", 
        RowBox[{"x", "++"}], ",", 
        RowBox[{
         RowBox[{"V", "=", 
          RowBox[{"VertexList", "[", 
           RowBox[{"NeighborhoodGraph", "[", 
            RowBox[{"g", ",", "x", ",", "1"}], "]"}], "]"}]}], ";", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"y", "=", "1"}], ",", 
           RowBox[{"y", "\[LessEqual]", 
            RowBox[{"Length", "[", "V", "]"}]}], ",", 
           RowBox[{"y", "++"}], ",", 
           RowBox[{
            RowBox[{"A", "[", 
             RowBox[{"[", 
              RowBox[{"x", ",", 
               RowBox[{"V", "[", 
                RowBox[{"[", "y", "]"}], "]"}]}], "]"}], "]"}], "=", "1"}]}], 
          "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"A", "-", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], "\[IndentingNewLine]",
     "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
