Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"verts", "=", 
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", "6"}], "]"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Total", "[", "#", "]"}], ",", "#"}], "}"}], "&"}]}], 
     "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Create", " ", "graph"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g6", "=", 
    RowBox[{"HypercubeGraph", "[", 
     RowBox[{"6", ",", 
      RowBox[{"VertexLabels", "->", "Automatic"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Distance", " ", "layers"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layers", "=", 
    RowBox[{"GatherBy", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "verts", "]"}], "]"}], ",", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"verts", "[", 
         RowBox[{"[", "#", "]"}], "]"}], "]"}], "&"}]}], "]"}]}], ";"}], "\n",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Symmetric", " ", "coordinates"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords", "=", 
    RowBox[{"Association", "@", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"layer", "=", 
              RowBox[{"layers", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], ",", 
             RowBox[{"m", "=", 
              RowBox[{"Length", "[", 
               RowBox[{"layers", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"layer", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "->", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"i", "-", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"m", "+", "1"}], ")"}], "/", "2"}]}]}], "}"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "m"}], "}"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "layers", "]"}]}], "}"}]}], "]"}], ",", 
       "1"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Graph", "[", 
  RowBox[{"g6", ",", 
   RowBox[{"VertexCoordinates", "->", "coords"}], ",", 
   RowBox[{"VertexLabels", "->", "None"}], ",", 
   RowBox[{"VertexSize", "->", "Medium"}], ",", 
   RowBox[{"EdgeStyle", "->", 
    RowBox[{"GrayLevel", "[", "0.75", "]"}]}], ",", 
   RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "Input",
