    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"res", "=", 
        RowBox[{"iFullRankDecomposition", "[", 
         RowBox[{"m", ",", "opts"}], "]"}]}], "}"}], ",", 
      RowBox[{"res", "/;", 
       RowBox[{"MatchQ", "[", 
        RowBox[{"res", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"_", "?", "MatrixQ"}], ",", 
           RowBox[{"_", "?", "MatrixQ"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
