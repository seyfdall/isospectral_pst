     RowBox[{"list", ",", 
      RowBox[{
       RowBox[{"Not", "[", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"#", ",", "var"}], "]"}], "]"}], "&"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Helper", " ", "function", " ", "to", " ", "extract", " ", "coeffs"}], 
    "*)"}], "\[IndentingNewLine]", 
