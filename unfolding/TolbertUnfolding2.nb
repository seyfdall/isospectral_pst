              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Ensure", " ", "each", " ", "entry", " ", "is", " ", "a", " ", 
                "list"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"terms", "=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Head", "[", "expr", "]"}], "===", "Plus"}], ",", 
                  RowBox[{"List", "@@", "expr"}], ",", 
                  RowBox[{"{", "expr", "}"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                "Quiet", " ", "suppresses", " ", "harmless", " ", "warnings", 
