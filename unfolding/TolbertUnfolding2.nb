         RowBox[{
          RowBox[{"(", 
           RowBox[{"num", "/", "c"}], ")"}], "/", "den"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
