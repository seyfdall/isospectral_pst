        "varTerms", ",", " ", "constantTerm"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"shape", "=", 
        RowBox[{"Dimensions", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Step", " ", "1"}], ":", 
         RowBox[{
         "Flatten", " ", "all", " ", "expressions", " ", "and", " ", 
