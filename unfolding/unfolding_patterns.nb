Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MyAdjacencyMatrix", "[", "G0_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", "=", "G0"}], "}"}], ",", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", 
        RowBox[{"VertexList", "[", "g", "]"}], "]"}]}], ";", 
      RowBox[{"A", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"x", "=", "1"}], ",", 
        RowBox[{"x", "\[LessEqual]", "n"}], ",", 
        RowBox[{"x", "++"}], ",", 
        RowBox[{
         RowBox[{"V", "=", 
          RowBox[{"VertexList", "[", 
           RowBox[{"NeighborhoodGraph", "[", 
            RowBox[{"g", ",", "x", ",", "1"}], "]"}], "]"}]}], ";", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"y", "=", "1"}], ",", 
           RowBox[{"y", "\[LessEqual]", 
            RowBox[{"Length", "[", "V", "]"}]}], ",", 
           RowBox[{"y", "++"}], ",", 
           RowBox[{
            RowBox[{"A", "[", 
             RowBox[{"[", 
              RowBox[{"x", ",", 
               RowBox[{"V", "[", 
                RowBox[{"[", "y", "]"}], "]"}]}], "]"}], "]"}], "=", "1"}]}], 
          "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"A", "-", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], "\[IndentingNewLine]",
     "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Smash", "[", 
    RowBox[{"G0_", ",", "S0_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"G", "=", "G0"}], ",", 
       RowBox[{"S", "=", "S0"}], ",", "V", ",", "A", ",", "Sbar"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Get", " ", "the", " ", "adjacency", " ", "matrix", " ", "of", " ", 
       "the", " ", "graph"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", "=", 
       RowBox[{"AdjacencyMatrix", "[", "G", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"V", "=", 
       RowBox[{"VertexList", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Map", " ", "vertex", " ", "labels", " ", "to", " ", "matrix", " ", 
        "indices"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"S", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"V", ",", "#"}], "]"}], "&"}], "/@", "S0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Sbar", "=", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "V", "]"}], "]"}], ",", "S"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Compute", " ", "the", " ", "Schur", " ", "complement", " ", 
        "formula"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"S", ",", "S"}], "]"}], "]"}], "-", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"[", 
          RowBox[{"S", ",", "Sbar"}], "]"}], "]"}], ".", 
        RowBox[{"Inverse", "[", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"[", 
            RowBox[{"Sbar", ",", "Sbar"}], "]"}], "]"}], "-", 
          RowBox[{"\[Lambda]", " ", 
           RowBox[{"IdentityMatrix", "[", 
            RowBox[{"Length", "[", "Sbar", "]"}], "]"}]}]}], "]"}], ".", 
        RowBox[{"A", "[", 
         RowBox[{"[", 
          RowBox[{"Sbar", ",", "S"}], "]"}], "]"}]}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SmashAdj", "[", 
   RowBox[{"A0_", ",", "G0_", ",", "S0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"A", "=", "A0"}], ",", 
      RowBox[{"G", "=", "G0"}], ",", 
      RowBox[{"S", "=", "S0"}], ",", "V", ",", "Sbar"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Get", " ", "the", " ", "adjacency", " ", "matrix", " ", "of", " ", 
      "the", " ", "graph"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"V", "=", 
      RowBox[{"VertexList", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Map", " ", "vertex", " ", "labels", " ", "to", " ", "matrix", " ", 
       "indices"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"S", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"V", ",", "#"}], "]"}], "&"}], "/@", "S0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Sbar", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "V", "]"}], "]"}], ",", "S"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Compute", " ", "the", " ", "Schur", " ", "complement", " ", 
       "formula"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"S", ",", "S"}], "]"}], "]"}], "-", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"S", ",", "Sbar"}], "]"}], "]"}], ".", 
       RowBox[{"Inverse", "[", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", 
           RowBox[{"Sbar", ",", "Sbar"}], "]"}], "]"}], "-", 
         RowBox[{"\[Lambda]", " ", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "Sbar", "]"}], "]"}]}]}], "]"}], ".", 
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"Sbar", ",", "S"}], "]"}], "]"}]}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.970234499299827*^9, 3.970234500820861*^9}, {
