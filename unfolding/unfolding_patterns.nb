Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "compute", " ", "the", 
    " ", "\"\<leading power of \[Lambda]\>\"", " ", "for", " ", "an", " ", 
    "entry"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FindNumDen", "[", 
      RowBox[{"expr_", ",", "\[Lambda]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"num", ",", "den"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"num", "=", 
         RowBox[{"Numerator", "[", 
          RowBox[{"Together", "[", "expr", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"den", "=", 
         RowBox[{"Denominator", "[", 
          RowBox[{"Together", "[", "expr", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"num", ",", " ", "den"}], "}"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Run", " ", "reductions", " ", "on", " ", "all", " ", "graphs", " ", "of",
      " ", "size", " ", "n"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ReductionFunctions", "[", 
      RowBox[{"n_", ",", "m_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "graphs", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"graphs", "=", 
         RowBox[{"GraphData", "/@", 
          RowBox[{"GraphData", "[", 
           RowBox[{"\"\<Connected\>\"", ",", "n"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "adjmat", ",", "key", ",", "powers", ",", "num", ",", "den"}], 
               "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"adjmat", "=", 
                RowBox[{"Simplify", "[", 
                 RowBox[{"Smash", "[", 
                  RowBox[{
                   RowBox[{"graphs", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "S"}], "]"}], 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                "canonicalize", " ", "matrix", " ", "form", " ", "for", " ", 
                 "comparison"}], "*)"}], "\[IndentingNewLine]", 
               RowBox[{"key", "=", 
                RowBox[{"Simplify", "[", 
                 RowBox[{"Normal", "[", "adjmat", "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"num", ",", " ", "den"}], "}"}], "=", 
                RowBox[{"Transpose", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"FindNumDen", "[", 
                    RowBox[{"#", ",", "\[Lambda]"}], "]"}], "&"}], "/@", 
                  RowBox[{"Flatten", "[", "adjmat", "]"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"<|", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"\"\<n\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"\"\<GraphIndex\>\"", "->", "i"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"\"\<Vertices\>\"", "->", "S"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"\"\<Reduction\>\"", "->", "key"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"\"\<f(\[Lambda])\>\"", "->", "num"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"\"\<g(\[Lambda])\>\"", "->", "den"}]}], 
                "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", 
             "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"Length", "[", "graphs", "]"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"S", ",", 
              RowBox[{"Subsets", "[", 
               RowBox[{
                RowBox[{"Range", "[", "n", "]"}], ",", 
