             "<>", "\"\<, Vertices = \>\"", "<>", 
             RowBox[{"ToString", "[", "verts", "]"}]}], ",", 
            RowBox[{"Darker", "@", "Green"}]}], "]"}], "\[IndentingNewLine]", 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"graphs", "=", 
          RowBox[{"GraphData", "/@", 
           RowBox[{"GraphData", "[", 
            RowBox[{"\"\<Connected\>\"", ",", "n"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"g", "=", 
          RowBox[{"graphs", "[", 
           RowBox[{"[", "gidx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"Graph", "[", 
