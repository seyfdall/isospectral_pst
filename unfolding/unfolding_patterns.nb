    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "loop", " ", "through", " ", "each", " ", "graph", " ", "that", " ", 
      "gave", " ", "this", " ", "reduction"}], "*)"}], "\[IndentingNewLine]", 
    
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
