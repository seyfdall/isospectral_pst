           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<n\>\""}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ids", "=", 
          RowBox[{"group", "[", 
