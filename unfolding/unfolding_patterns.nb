Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ReductionPowers", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "graphs", "}"}], ",", 
     RowBox[{
      RowBox[{"graphs", "=", 
       RowBox[{"GraphData", "/@", 
        RowBox[{"GraphData", "[", 
         RowBox[{"\"\<Connected\>\"", ",", "n"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "adjmat", ",", "key", ",", "powers", ",", "numExp", ",", 
              "denExp", ",", "rpow"}], "}"}], ",", 
            RowBox[{
             RowBox[{"adjmat", "=", 
              RowBox[{"Simplify", "[", 
               RowBox[{"Smash", "[", 
                RowBox[{
                 RowBox[{"graphs", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "S"}], "]"}], "]"}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"key", "=", 
              RowBox[{"Simplify", "[", 
               RowBox[{"Normal", "[", "adjmat", "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"powers", ",", "numExp", ",", "denExp"}], "}"}], "=", 
              RowBox[{"Transpose", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"LeadingPower", "[", 
                  RowBox[{"#", ",", "\[Lambda]"}], "]"}], "&"}], "/@", 
                RowBox[{"Flatten", "[", "adjmat", "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"rpow", "=", 
              RowBox[{"ReductionPower", "[", 
               RowBox[{"adjmat", ",", "\[Lambda]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
               RowBox[{"\"\<GraphIndex\>\"", "->", "i"}], ",", 
               RowBox[{"\"\<Vertices\>\"", "->", "S"}], ",", 
               RowBox[{"\"\<Reduction\>\"", "->", "key"}], ",", 
               RowBox[{"\"\<ReductionPower\>\"", "->", "rpow"}], ",", 
               RowBox[{"\"\<Powers\>\"", "->", "powers"}], ",", 
               RowBox[{"\"\<NumExp\>\"", "->", "numExp"}], ",", 
               RowBox[{"\"\<DenExp\>\"", "->", "denExp"}]}], "|>"}]}]}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "graphs", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"S", ",", 
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"Range", "[", "n", "]"}], ",", 
              RowBox[{"{", "m", "}"}]}], "]"}]}], "}"}]}], "]"}], ",", "1"}], 
       "]"}]}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TargetReductionPower", "[", 
    RowBox[{"expr_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"LeadingPower", "[", 
     RowBox[{"expr", ",", "\[Lambda]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"target", "=", 
    RowBox[{"TargetReductionPower", "[", 
     RowBox[{
      RowBox[{"1", "/", "\[Lambda]"}], ",", "\[Lambda]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Select", "[", 
   RowBox[{"data", ",", 
    RowBox[{
     RowBox[{"#ReductionPower", "==", "target"}], "&"}]}], "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FindReductionMatches", "[", 
    RowBox[{"data_", ",", "expr_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", "=", 
       RowBox[{"TargetReductionPower", "[", 
        RowBox[{"expr", ",", "\[Lambda]"}], "]"}]}], "}"}], ",", 
     RowBox[{"Select", "[", 
      RowBox[{"data", ",", 
       RowBox[{
        RowBox[{"#ReductionPower", "==", "p"}], "&"}]}], "]"}]}], "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"matches", "=", 
   RowBox[{"FindReductionMatches", "[", 
    RowBox[{"data", ",", 
     RowBox[{"1", "/", "\[Lambda]"}], ",", "\[Lambda]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Length", "[", "matches", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"GroupBy", "[", 
  RowBox[{"matches", ",", 
   RowBox[{
    RowBox[{"Simplify", "[", "#Reduction", "]"}], "&"}], ",", 
   RowBox[{
    RowBox[{"#", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<n\>\"", ",", "\"\<GraphIndex\>\"", 
         ",", "\"\<Vertices\>\""}], "}"}]}], "]"}], "]"}], "&"}]}], 
