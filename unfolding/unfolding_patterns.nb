     "loop", " ", "through", " ", "each", " ", "graph", " ", "that", " ", 
      "gave", " ", "this", " ", "reduction"}], "*)"}], "\[IndentingNewLine]", 
    
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
