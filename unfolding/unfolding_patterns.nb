Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ReductionFunctions", "[", 
       RowBox[{"n", ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "2", ",", "14"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ConnectedGraphs", "[", "n_List", "]"}], ":=", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"n", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphData", "/@", 
        RowBox[{"GraphData", "[", 
         RowBox[{"\"\<Connected\>\"", ",", "#"}], "]"}]}], "&"}], "/@", 
      "n"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"graphCache", "=", 
    RowBox[{"ConnectedGraphs", "[", 
     RowBox[{"Union", "[", 
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "\"\<n\>\""}], "]"}], "]"}], "]"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ShowReduction", "[", 
   RowBox[{"assoc_", ",", "cache_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "idx", ",", "verts", ",", "G"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "idx", ",", "verts"}], "}"}], "=", 
      RowBox[{"assoc", "/@", 
       RowBox[{"{", 
        RowBox[{"\"\<n\>\"", ",", "\"\<GraphIndex\>\"", 
         ",", "\"\<Vertices\>\""}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"G", "=", 
      RowBox[{
       RowBox[{"cache", "[", "n", "]"}], "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Graph\>\"", "->", "G"}], ",", 
       RowBox[{"\"\<Vertices\>\"", "->", "verts"}], ",", 
       RowBox[{"\"\<Reduction\>\"", "->", 
        RowBox[{"Simplify", "[", 
         RowBox[{"Smash", "[", 
          RowBox[{"G", ",", "verts"}], "]"}], "]"}]}]}], "|>"}]}]}], 
   "]"}]}]}], "Input",
