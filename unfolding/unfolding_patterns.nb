Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ReductionPowers", "[", 
       RowBox[{"n", ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "4", ",", "8"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sameReductions", "=", 
   RowBox[{"GroupBy", "[", 
    RowBox[{"data", ",", 
     RowBox[{
      RowBox[{"Simplify", "[", "#Reduction", "]"}], "&"}], ",", 
     RowBox[{
      RowBox[{"#", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<n\>\"", ",", "\"\<GraphIndex\>\"", 
           ",", "\"\<Vertices\>\""}], "}"}]}], "]"}], "]"}], "&"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"matches", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"sameReductions", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", " ", "//", " ", "Length"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "how", " ", "many", " ", "original", " ", "graphs", " ", "there", " ", 
    "are"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Length", "[", "matches", "]"}], "     ", 
  RowBox[{"(*", 
   RowBox[{
   "how", " ", "many", " ", "unique", " ", "reductions", " ", "appear", " ", 
    "in", " ", "multiple", " ", "graphs"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"matches", "[", 
   RowBox[{"[", "1", "]"}], "]"}], "                  ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"look", " ", "at", " ", "one", " ", "reduction"}], 
     "\[CloseCurlyQuote]"}], "s", " ", "equivalence", " ", "class"}], 
   "*)"}]}]}], "Input",
