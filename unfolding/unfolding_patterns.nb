Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"\"\<=== Match \>\"", "<>", 
        RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\< ===\>\""}], ",", 
