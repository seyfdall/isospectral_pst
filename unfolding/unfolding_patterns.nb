      RowBox[{"{", 
       RowBox[{"n", ",", "4", ",", "8"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sameReductions", "=", 
   RowBox[{"GroupBy", "[", 
    RowBox[{"data", ",", 
     RowBox[{
      RowBox[{"Simplify", "[", "#Reduction", "]"}], "&"}], ",", 
     RowBox[{
      RowBox[{"#", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<n\>\"", ",", "\"\<GraphIndex\>\"", 
           ",", "\"\<Vertices\>\""}], "}"}]}], "]"}], "]"}], "&"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"matches", "=", 
