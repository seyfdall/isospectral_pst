 RowBox[{
  RowBox[{"filteredMatches", "=", 
   RowBox[{"Select", "[", "\[IndentingNewLine]", 
    RowBox[{"matches", ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"group", "=", "#"}], ",", "ns", ",", "ids"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ns", "=", 
          RowBox[{"group", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<n\>\""}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ids", "=", 
          RowBox[{"group", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<GraphIndex\>\""}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"ns", ",", "ids"}], "}"}], "]"}], "]"}], "]"}], ">", 
           "1"}], ")"}]}]}], "\[IndentingNewLine]", "]"}], "&"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
