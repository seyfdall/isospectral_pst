Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ReductionPowers", "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "compute", " ", "the", 
    " ", "\"\<leading power of \[Lambda]\>\"", " ", "for", " ", "an", " ", 
    "entry"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LeadingPower", "[", 
     RowBox[{"expr_", ",", "\[Lambda]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"num", ",", "den", ",", " ", "numExp", ",", " ", "denExp"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"num", "=", 
        RowBox[{"Numerator", "[", 
         RowBox[{"Together", "[", "expr", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"den", "=", 
        RowBox[{"Denominator", "[", 
         RowBox[{"Together", "[", "expr", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"numExp", " ", "=", " ", 
        RowBox[{"Exponent", "[", 
         RowBox[{"num", ",", "\[Lambda]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"denExp", " ", "=", " ", 
        RowBox[{"Exponent", "[", 
         RowBox[{"den", ",", "\[Lambda]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"numExp", " ", "-", " ", "denExp"}], ",", " ", "numExp", ",",
          " ", "denExp"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Run", " ", "reductions", " ", "on", " ", "all", " ", "graphs", " ", "of", 
    " ", "size", " ", "n"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReductionPowers", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "graphs", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"graphs", "=", 
       RowBox[{"GraphData", "/@", 
        RowBox[{"GraphData", "[", 
         RowBox[{"\"\<Connected\>\"", ",", "n"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"adjmat", ",", "powers", ",", "numExp", ",", "denExp"}], 
             "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"adjmat", "=", 
              RowBox[{"Simplify", "[", 
               RowBox[{"Smash", "[", 
                RowBox[{
                 RowBox[{"graphs", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "S"}], "]"}], "]"}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"powers", ",", "numExp", ",", "denExp"}], "}"}], "=", 
              RowBox[{"Transpose", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"LeadingPower", "[", 
                  RowBox[{"#", ",", "\[Lambda]"}], "]"}], "&"}], "/@", 
                RowBox[{"Flatten", "[", "adjmat", "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"<|", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"\"\<GraphIndex\>\"", "->", "i"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"\"\<Vertices\>\"", "->", "S"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"\"\<reduction\>\"", "->", "adjmat"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"\"\<Powers\>\"", "->", "powers"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"\"\<NumExp\>\"", "->", "numExp"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"\"\<DenExp\>\"", "->", "denExp"}]}], 
              "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", "]"}],
           ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "graphs", "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"S", ",", 
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"Range", "[", "n", "]"}], ",", 
              RowBox[{"{", "m", "}"}]}], "]"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", "1"}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9685424893696117`*^9, 3.968542489495075*^9}, {
   3.968542539866414*^9, 3.9685425870188093`*^9}, 3.968542655411229*^9, {
