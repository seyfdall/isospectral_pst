Cell[CellGroupData[{

Cell["Same Reduction Finding", "Chapter",
 CellChangeTimes->{{3.9688717979261427`*^9, 3.968871813712727*^9}, {
  3.968874318050377*^9, 
  3.968874318506081*^9}},ExpressionUUID->"1af0daf1-0fd0-44df-aadd-\
eb7f6f910902"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ReductionPowers", "]"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "compute", " ", "the", 
    " ", "\"\<leading power of \[Lambda]\>\"", " ", "for", " ", "an", " ", 
    "entry"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LeadingPower", "[", 
     RowBox[{"expr_", ",", "\[Lambda]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"num", ",", "den", ",", " ", "numExp", ",", " ", "denExp"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"num", "=", 
        RowBox[{"Numerator", "[", 
         RowBox[{"Together", "[", "expr", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"den", "=", 
        RowBox[{"Denominator", "[", 
         RowBox[{"Together", "[", "expr", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"numExp", " ", "=", " ", 
        RowBox[{"Exponent", "[", 
         RowBox[{"num", ",", "\[Lambda]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"denExp", " ", "=", " ", 
        RowBox[{"Exponent", "[", 
         RowBox[{"den", ",", "\[Lambda]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"numExp", " ", "-", " ", "denExp"}], ",", " ", "numExp", ",",
          " ", "denExp"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Run", " ", "reductions", " ", "on", " ", "all", " ", "graphs", " ", "of", 
    " ", "size", " ", "n"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReductionPowers", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "graphs", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"graphs", "=", 
       RowBox[{"GraphData", "/@", 
        RowBox[{"GraphData", "[", 
         RowBox[{"\"\<Connected\>\"", ",", "n"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "adjmat", ",", "key", ",", "powers", ",", "numExp", ",", 
              "denExp"}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"adjmat", "=", 
              RowBox[{"Simplify", "[", 
               RowBox[{"Smash", "[", 
                RowBox[{
                 RowBox[{"graphs", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "S"}], "]"}], "]"}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
              "canonicalize", " ", "matrix", " ", "form", " ", "for", " ", 
               "comparison"}], "*)"}], "\[IndentingNewLine]", 
             RowBox[{"key", "=", 
              RowBox[{"Simplify", "[", 
               RowBox[{"Normal", "[", "adjmat", "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"powers", ",", "numExp", ",", "denExp"}], "}"}], "=", 
              RowBox[{"Transpose", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"LeadingPower", "[", 
                  RowBox[{"#", ",", "\[Lambda]"}], "]"}], "&"}], "/@", 
                RowBox[{"Flatten", "[", "adjmat", "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"<|", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"\"\<n\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
               RowBox[{"\"\<GraphIndex\>\"", "->", "i"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"\"\<Vertices\>\"", "->", "S"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"\"\<Reduction\>\"", "->", "key"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"\"\<Powers\>\"", "->", "powers"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"\"\<NumExp\>\"", "->", "numExp"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"\"\<DenExp\>\"", "->", "denExp"}]}], 
              "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", "]"}],
           ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "graphs", "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"S", ",", 
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"Range", "[", "n", "]"}], ",", 
              RowBox[{"{", "m", "}"}]}], "]"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", "1"}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{
  3.968871818493924*^9, {3.9688724530278*^9, 3.96887249973822*^9}, {
   3.968872541419445*^9, 3.9688725420339603`*^9}, {3.968873950951536*^9, 
   3.968873955031376*^9}, {3.9688746558039293`*^9, 3.968874656522456*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"8267a96b-0d94-4762-8767-523a29a4479b"],

Cell[CellGroupData[{

Cell["Single Vertex Reduction Matching", "Section",
 CellChangeTimes->{{3.96921935104042*^9, 
  3.9692193586882763`*^9}},ExpressionUUID->"941a0098-3afc-4d89-b7a0-\
6bf27236f376"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ReductionPowers", "[", 
       RowBox[{"n", ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "4", ",", "8"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sameReductions", "=", 
   RowBox[{"GroupBy", "[", 
    RowBox[{"data", ",", 
     RowBox[{
      RowBox[{"Simplify", "[", "#Reduction", "]"}], "&"}], ",", 
     RowBox[{
      RowBox[{"#", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<n\>\"", ",", "\"\<GraphIndex\>\"", 
           ",", "\"\<Vertices\>\""}], "}"}]}], "]"}], "]"}], "&"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"matches", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"sameReductions", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", " ", "//", " ", "Length"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "how", " ", "many", " ", "original", " ", "graphs", " ", "there", " ", 
    "are"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Length", "[", "matches", "]"}], "     ", 
  RowBox[{"(*", 
   RowBox[{
   "how", " ", "many", " ", "unique", " ", "reductions", " ", "appear", " ", 
