  3.969219376512127*^9}},ExpressionUUID->"d897be84-5342-42ce-8475-\
00756185ca5c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ReductionPowers", "[", 
       RowBox[{"n", ",", "2"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "4", ",", "8"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sameReductions", "=", 
   RowBox[{"GroupBy", "[", 
    RowBox[{"data", ",", 
     RowBox[{
      RowBox[{"Simplify", "[", "#Reduction", "]"}], "&"}], ",", 
     RowBox[{
      RowBox[{"#", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<n\>\"", ",", "\"\<GraphIndex\>\"", 
           ",", "\"\<Vertices\>\""}], "}"}]}], "]"}], "]"}], "&"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"matches", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"sameReductions", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", " ", "//", " ", "Length"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "how", " ", "many", " ", "original", " ", "graphs", " ", "there", " ", 
    "are"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Length", "[", "matches", "]"}], "     ", 
  RowBox[{"(*", 
   RowBox[{
   "how", " ", "many", " ", "unique", " ", "reductions", " ", "appear", " ", 
    "in", " ", "multiple", " ", "graphs"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"matches", "[", 
   RowBox[{"[", "1", "]"}], "]"}], "                  "}]}], "Input",
 CellChangeTimes->{{3.969219382356927*^9, 3.969219382422126*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"0651266f-1d20-4c12-bcbe-6e6da62ca589"],

