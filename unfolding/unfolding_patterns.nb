Cell[CellGroupData[{
Cell["Unfolding Pattern Search", "Title",
 CellChangeTimes->{{3.9688716508225594`*^9, 
  3.9688716582403517`*^9}},ExpressionUUID->"ab7d84cc-8e81-49a6-8392-\
8765772227cf"],

Cell[CellGroupData[{

Cell["Global Functions", "Chapter",
 CellChangeTimes->{{3.96887167656139*^9, 
  3.9688716921829767`*^9}},ExpressionUUID->"5ff6fd4c-bb78-4b31-bfec-\
bb76d03daea5"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MyAdjacencyMatrix", "[", "G0_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", "=", "G0"}], "}"}], ",", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"VertexList", "[", "g", "]"}], "]"}]}], ";", 
     RowBox[{"A", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"x", "=", "1"}], ",", 
       RowBox[{"x", "\[LessEqual]", "n"}], ",", 
       RowBox[{"x", "++"}], ",", 
       RowBox[{
        RowBox[{"V", "=", 
         RowBox[{"VertexList", "[", 
          RowBox[{"NeighborhoodGraph", "[", 
           RowBox[{"g", ",", "x", ",", "1"}], "]"}], "]"}]}], ";", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"y", "=", "1"}], ",", 
          RowBox[{"y", "\[LessEqual]", 
           RowBox[{"Length", "[", "V", "]"}]}], ",", 
          RowBox[{"y", "++"}], ",", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", 
             RowBox[{"x", ",", 
              RowBox[{"V", "[", 
               RowBox[{"[", "y", "]"}], "]"}]}], "]"}], "]"}], "=", "1"}]}], 
         "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"A", "-", 
      RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"249e9111-e2e7-4bd5-94af-df7fc53da48e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Smash", "[", 
   RowBox[{"G0_", ",", "S0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"G", "=", "G0"}], ",", 
      RowBox[{"S", "=", "S0"}], ",", "V", ",", "A", ",", "Sbar"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Get", " ", "the", " ", "adjacency", " ", "matrix", " ", "of", " ", 
      "the", " ", "graph"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"A", "=", 
      RowBox[{"AdjacencyMatrix", "[", "G", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"V", "=", 
      RowBox[{"VertexList", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Map", " ", "vertex", " ", "labels", " ", "to", " ", "matrix", " ", 
       "indices"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"S", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"V", ",", "#"}], "]"}], "&"}], "/@", "S0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Sbar", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "V", "]"}], "]"}], ",", "S"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Compute", " ", "the", " ", "Schur", " ", "complement", " ", 
       "formula"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"S", ",", "S"}], "]"}], "]"}], "-", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"S", ",", "Sbar"}], "]"}], "]"}], ".", 
       RowBox[{"Inverse", "[", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", 
           RowBox[{"Sbar", ",", "Sbar"}], "]"}], "]"}], "-", 
         RowBox[{"\[Lambda]", " ", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "Sbar", "]"}], "]"}]}]}], "]"}], ".", 
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"Sbar", ",", "S"}], "]"}], "]"}]}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.968542421448558*^9, 3.968542421760515*^9}, {
  3.968542553185006*^9, 3.968542554687767*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"e378f4c7-ca5f-4c83-a7f6-e39ba00cd4dd"]
}, Open  ]],

