   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FullRankDecomposition", "[", 
     RowBox[{
      RowBox[{"m_", "?", "MatrixQ"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"res", "=", 
        RowBox[{"iFullRankDecomposition", "[", 
         RowBox[{"m", ",", "opts"}], "]"}]}], "}"}], ",", 
      RowBox[{"res", "/;", 
       RowBox[{"MatchQ", "[", 
        RowBox[{"res", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"_", "?", "MatrixQ"}], ",", 
           RowBox[{"_", "?", "MatrixQ"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"iFullRankDecomposition", "[", 
