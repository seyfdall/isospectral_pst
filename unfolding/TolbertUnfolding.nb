           RowBox[{"{", 
            RowBox[{"um", ",", "sig", ",", "vm"}], "}"}], "=", "svd"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"rank", "=", 
           RowBox[{"LengthWhile", "[", 
            RowBox[{
             RowBox[{"sig", "=", 
