           RowBox[{"m", ",", 
            RowBox[{"SparseArray", "|", "StructuredArray"}]}], "]"}]}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MatrixQ", "[", 
           RowBox[{"m", ",", "NumericQ"}], "]"}], "&&", 
          RowBox[{
           RowBox[{"Internal`EffectivePrecision", "[", "m", "]"}], "<", 
           "\[Infinity]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"svd", "=", 
           RowBox[{"SingularValueDecomposition", "[", 
            RowBox[{"m", ",", 
             RowBox[{"FilterRules", "[", 
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"{", "opts", "}"}], ",", 
                 RowBox[{"Options", "[", "FullRankDecomposition", "]"}]}], 
                "]"}], ",", 
               RowBox[{"Options", "[", "SingularValueDecomposition", "]"}]}], 
              "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"MatchQ", "[", 
              RowBox[{"svd", ",", 
               RowBox[{"{", 
                RowBox[{"__", "?", "MatrixQ"}], "}"}]}], "]"}]}], ",", 
            RowBox[{"Return", "[", 
